# Private listeners behind the HTTPS/WSS gateway.
PORT=3100
WS_PORT=3101
HTTP_ONLY=1

# The only frontend value embedded by Vite. This is public, not a secret.
VITE_DISCORD_CLIENT_ID=

# Public gateway. Use both TLS paths for direct TLS, or TRUST_PROXY_TLS=true
# only behind a hosting edge that terminates HTTPS/WSS. ALLOW_INSECURE_HTTP is
# restricted to loopback testing.
PUBLIC_HOST=0.0.0.0
PUBLIC_PORT=3443
TLS_KEY_PATH=
TLS_CERT_PATH=
TRUST_PROXY_TLS=false
WEBAVERSE_HTTP_HOST=127.0.0.1
WEBAVERSE_HTTP_PORT=3100
WEBAVERSE_WS_HOST=127.0.0.1
WEBAVERSE_WS_PORT=3101
