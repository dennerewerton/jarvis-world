+const prepareSectorVisuals = (group, sector) => {
+  let surfaceRoots = 0;
+  const vehicleRoots = [];
+
+  for (const root of group.children) {
+    const criticalGround = GROUND_ROOT_PATTERN.test(root.name);
+    const vehicle = VEHICLE_ROOT_PATTERN.test(root.name);
+    if (criticalGround) surfaceRoots++;
+    if (vehicle) vehicleRoots.push(root);
+
+    root.traverse(node => {
+      if (!node.isMesh) return;
+      node.castShadow = false;
+      node.receiveShadow = true;
+      // GLTF road and sidewalk roots are very flat. Their imported bounds are
+      // valid for geometry, but too thin for reliable camera-angle culling.
+      // Keep only this critical walking surface visible at every angle.
+      node.frustumCulled = !criticalGround;
+      if (!criticalGround) return;
+      const materials = Array.isArray(node.material) ? node.material : [node.material];
+      for (const material of materials) {
+        if (!material || material.transparent || material.opacity < 1) continue;
+        material.depthTest = true;
+        material.depthWrite = true;
+        material.side = THREE.DoubleSide;
+        material.needsUpdate = true;
+      }
+    });
+  }
+
+  if (CITY_DEVELOPMENT_VALIDATION) {
+    if (!surfaceRoots) console.warn(`Jarvis City sector ${sector.id} has no walking surface.`);
+    for (const vehicle of vehicleRoots) {
+      const bounds = new THREE.Box3().setFromObject(vehicle);
+      if (!Number.isFinite(bounds.min.y) || !Number.isFinite(bounds.max.y) || bounds.min.y > 0.35 || bounds.min.y < -1) {
+        console.warn(`Jarvis City vehicle ${vehicle.name} has an invalid ground offset in ${sector.id}.`);
+      }
+    }
+  }
+  return surfaceRoots;
+};
