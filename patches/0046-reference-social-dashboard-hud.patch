+@media (max-width: 1180px) {
+  .profile { width: 320px; }
+  .socialAgenda { width: 300px; }
+  .featureStack { width: 300px; }
+  .chatPrompt { width: 330px; }
+  .brandPlate { display: none; }
+}
+
+@media (max-width: 900px) {
+  .profile { top: 12px; left: 12px; width: 270px; min-height: 70px; padding-left: 65px; }
+  .avatarRing { width: 58px; height: 58px; }
+  .profileCopy strong { font-size: 16px; }
+  .profileCopy em, .jarvisBadge { display: none; }
+  .topBar { top: 12px; right: 12px; }
+  .wallet { min-width: 135px; height: 46px; }
+  .coin { width: 28px; height: 28px; }
+  .wallet strong { font-size: 15px; }
+  .topBar button { width: 44px; height: 44px; }
+  .socialAgenda, .featureStack { width: 240px; right: 12px; }
+  .socialAgenda { top: 76px; padding: 9px 11px; }
+  .socialAgenda p { min-height: 32px; font-size: 10px; }
+  .featureStack { top: 232px; gap: 7px; }
+  .featureStack button { min-height: 56px; padding: 6px 10px; grid-template-columns: 34px 1fr 10px; }
+  .featureStack button > span { height: 34px; font-size: 18px; }
+  .featureStack strong { font-size: 12px; }
+  .leftRail { top: 100px; left: 12px; }
+  .leftRail button { width: 58px; min-height: 54px; border-radius: 13px; }
+  .leftRail button > span { width: 23px; height: 23px; font-size: 12px; }
+  .leftRail button strong { font-size: 9px; }
+  .socialDock { left: 12px; bottom: 12px; }
+  .socialDock button { min-width: 70px; min-height: 60px; border-radius: 14px; }
+  .chatPrompt { left: auto; right: 12px; bottom: 16px; width: 300px; transform: none; }
+  .movement, .status { display: none; }
+}
+
+@media (max-width: 620px) {
+  .socialAgenda, .featureStack { display: none; }
+  .profile { width: 210px; }
+  .profileCopy > span { display: none; }
+  .wallet { min-width: 105px; }
+  .wallet small, .topBar button:nth-last-child(2) { display: none; }
+  .topBar button { width: 40px; }
+  .leftRail { top: auto; right: 12px; bottom: 82px; grid-template-columns: repeat(5, 1fr); }
+  .leftRail button { width: 52px; min-height: 48px; }
+  .leftRail button strong, .leftRail kbd { display: none; }
+  .socialDock button { min-width: 58px; min-height: 52px; padding: 5px; }
+  .socialDock button strong { font-size: 10px; }
+  .chatPrompt { display: none; }
+  .guideGrid { grid-template-columns: 1fr; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .hud button { transition: none !important; }
