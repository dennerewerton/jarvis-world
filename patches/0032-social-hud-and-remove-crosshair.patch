--- /dev/null
+++ b/src/SocialHud.jsx
@@ -0,0 +1,39 @@
+import React, {useContext, useState} from 'react';
+
+import {AppContext} from './components/app';
+import styles from './SocialHud.module.css';
+
+export default function SocialHud() {
+  const {state, setState} = useContext(AppContext);
+  const [showControls, setShowControls] = useState(false);
+
+  const openChat = () => {
+    setState({openedPanel: state.openedPanel === 'ChatPanel' ? null : 'ChatPanel'});
+  };
+  const openEmotes = () => {
+    setShowControls(false);
+    window.dispatchEvent(new Event('jarvis-open-emotes'));
+  };
+
+  return (
+    <nav className={styles.hud} aria-label="Acoes sociais">
+      {showControls ? (
+        <div className={styles.controls}>
+          <strong>Controles</strong>
+          <span>WASD mover · Espaco pular</span>
+          <span>Roda do mouse aproxima a camera</span>
+          <span>Enter ou Chat para conversar · Q para emotes</span>
+        </div>
+      ) : null}
+      <div className={styles.actions}>
+        <button type="button" className={state.openedPanel === 'ChatPanel' ? styles.active : ''} onClick={openChat}>
+          Chat
+        </button>
+        <button type="button" onClick={openEmotes}>Emotes</button>
+        <button type="button" className={showControls ? styles.active : ''} onClick={() => setShowControls(value => !value)}>
+          Controles
+        </button>
+      </div>
+    </nav>
+  );
+}
diff --git a/src/SocialHud.module.css b/src/SocialHud.module.css
new file mode 100644
