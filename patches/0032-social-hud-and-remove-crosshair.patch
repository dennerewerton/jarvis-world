+++ b/src/SocialHud.module.css
@@ -0,0 +1,67 @@
+.hud {
+  position: fixed;
+  left: 18px;
+  bottom: 18px;
+  z-index: 4;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 8px;
+  color: #eaf9ff;
+  font-family: Muli, Arial, sans-serif;
+  pointer-events: none;
+  user-select: none;
+}
+
+.actions,
+.controls {
+  pointer-events: auto;
+  border: 1px solid rgba(86, 219, 255, 0.55);
+  background: rgba(5, 20, 35, 0.86);
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24);
+  backdrop-filter: blur(5px);
+}
+
+.actions {
+  display: flex;
+  overflow: hidden;
+  border-radius: 10px;
+}
+
+.actions button {
+  min-height: 38px;
+  padding: 0 13px;
+  border: 0;
+  border-right: 1px solid rgba(126, 224, 255, 0.25);
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  font-size: 13px;
+  cursor: pointer;
+}
+
+.actions button:last-child {
+  border-right: 0;
+}
+
+.actions button:hover,
+.actions button:focus-visible,
+.actions button.active {
+  outline: none;
+  background: rgba(61, 190, 231, 0.32);
+}
+
+.controls {
+  display: grid;
+  gap: 5px;
+  max-width: 290px;
+  padding: 11px 13px;
+  border-radius: 10px;
+  font-size: 12px;
+  line-height: 1.3;
+}
+
+.controls strong {
+  color: #65ddff;
+  font-size: 13px;
+}
