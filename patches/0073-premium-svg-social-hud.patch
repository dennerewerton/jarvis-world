+import React, {useContext, useState} from 'react';
+
+import {AppContext} from './components/app';
+import {activityApi} from './jarvis-compat/activity-api.mjs';
+import {JarvisIdentityContext} from './jarvis-compat/ActivityShell.jsx';
+
+const Icon = ({name, size = 26}) => {
+  const p = {
+    width: size,
+    height: size,
+    viewBox: '0 0 24 24',
+    fill: 'none',
+    stroke: 'currentColor',
+    strokeWidth: 1.9,
+    strokeLinecap: 'round',
+    strokeLinejoin: 'round',
+    'aria-hidden': true,
+  };
+  const icons = {
+    map: <><path d="M3 6l5-3 8 3 5-3v15l-5 3-8-3-5 3z"/><path d="M8 3v15M16 6v15"/></>,
+    users: <><circle cx="9" cy="8" r="3"/><path d="M3 19c.5-3.5 2.5-5.5 6-5.5s5.5 2 6 5.5"/><circle cx="17.5" cy="9" r="2"/><path d="M16 14c2.8-.3 4.5 1.2 5 4"/></>,
+    daily: <><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4M17 3v4M3 10h18"/><path d="m8 15 2 2 5-5"/></>,
+    shop: <><path d="M4 10h16l-1-5H5z"/><path d="M5 10v10h14V10M9 20v-6h6v6"/></>,
+    guide: <><circle cx="12" cy="12" r="9"/><path d="m16 8-3 6-6 3 3-6z"/></>,
+    gear: <><circle cx="12" cy="12" r="3"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/></>,
+    mail: <><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></>,
+    event: <><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4M17 3v4M3 10h18"/><path d="m12 12 1 2 2 .3-1.5 1.5.4 2.2-1.9-1-1.9 1 .4-2.2L9 14.3l2-.3z"/></>,
+    chat: <><path d="M4 5h16v12H9l-5 3z"/><path d="M8 11h.1M12 11h.1M16 11h.1"/></>,
+    smile: <><circle cx="12" cy="12" r="9"/><path d="M8 14c1 2 2.4 3 4 3s3-1 4-3M8.5 9h.1M15.5 9h.1"/></>,
+    run: <><circle cx="15" cy="4" r="2"/><path d="m13 8-3 4 4 2 1 6M13 8l4 2 3-1M10 12l-3 5-3 1M14 14l-4 5"/></>,
+    jump: <><path d="M12 20V5m-6 6 6-6 6 6M5 20h14"/></>,
+    crown: <><path d="m4 8 4 3 4-6 4 6 4-3-2 10H6zM6 18h12"/></>,
+    target: <><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v4M22 12h-4M12 22v-4M2 12h4"/></>,
+    coin: <><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="6"/><path d="M15 9c-1-.8-5-1.2-5 1 0 2 5 1 5 4 0 2-4 2-6 1M12 7v10"/></>,
+  };
+  return <svg {...p}>{icons[name] || icons.guide}</svg>;
+};
+
+const navItems = [
+  ['map', 'map', 'Mapa', 'M'],
+  ['social', 'users', 'Social', 'P'],
+  ['daily', 'daily', 'Daily', 'D'],
+  ['shop', 'shop', 'Loja', 'L'],
+  ['guide', 'guide', 'Guia', 'G'],
+];
+
+const css = `
+.jw-hud{position:fixed;inset:0;z-index:1000;pointer-events:none;user-select:none;color:#f6fbff;font-family:Inter,Muli,system-ui,sans-serif;text-shadow:0 1px 2px #00152b}
+.jw-hud *{box-sizing:border-box}.jw-hud button{pointer-events:auto;color:inherit;font:inherit;cursor:pointer}
+.jw-panel{background:linear-gradient(135deg,rgba(4,21,49,.96),rgba(7,68,112,.91));border:2px solid rgba(63,218,255,.85);box-shadow:0 12px 30px rgba(0,0,0,.4),inset 0 0 24px rgba(51,206,255,.1)}
+.jw-profile{position:fixed;left:16px;top:16px;width:310px;height:78px;border-radius:18px 18px 32px 18px;display:flex;align-items:center;padding:8px 36px 8px 72px;gap:10px;clip-path:polygon(0 0,100% 0,94% 100%,8% 100%,0 76%)}
+.jw-avatar{position:absolute;left:-2px;width:66px;height:66px;border-radius:50%;overflow:hidden;display:grid;place-items:center;background:radial-gradient(circle at 35% 30%,#a66cff,#164d9b 70%);border:4px solid #84efff;box-shadow:0 0 0 4px rgba(144,83,255,.7),0 0 18px #43dfff;font-size:24px;font-weight:900}
+.jw-avatar img{width:100%;height:100%;object-fit:cover}.jw-profile div:last-child{display:grid;min-width:0}.jw-profile strong{font-size:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-transform:uppercase}.jw-profile span{font-size:11px;color:#b7dbf4}.jw-profile em{font-style:normal;color:#7feaff;font-size:8px;font-weight:800;letter-spacing:.12em;margin-top:3px}
+.jw-top{position:fixed;right:16px;top:16px;display:flex;gap:8px;align-items:center}.jw-wallet{height:48px;min-width:165px;border-radius:18px;display:flex;align-items:center;gap:8px;padding:0 12px;background:linear-gradient(135deg,rgba(6,24,45,.96),rgba(5,89,79,.92));border:2px solid rgba(54,238,173,.82);box-shadow:0 8px 20px rgba(0,0,0,.35)}.jw-coin{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;color:#9b5900;background:linear-gradient(145deg,#fff47c,#ffb000);box-shadow:inset 0 0 0 3px #d97d00;color:#fff2a2}.jw-wallet strong{margin-left:auto;font-size:17px}.jw-wallet small{font-size:9px;color:#8effd1;font-weight:900}.jw-top>button{width:46px;height:46px;border-radius:14px;border:1px solid rgba(75,219,255,.75);background:linear-gradient(145deg,#0a315d,#075a8a);display:grid;place-items:center;box-shadow:0 7px 16px rgba(0,0,0,.34)}.jw-top>button:hover{transform:translateY(-2px);border-color:#fff}
+.jw-rail{position:fixed;left:16px;top:112px;display:grid;gap:8px}.jw-rail button{width:62px;height:62px;border-radius:15px;border:1px solid rgba(77,221,255,.75);background:linear-gradient(145deg,rgba(5,27,57,.97),rgba(9,77,116,.94));display:grid;place-items:center;padding:5px;position:relative;box-shadow:0 7px 17px rgba(0,0,0,.35)}.jw-rail button:hover,.jw-rail button.active{border-color:#c071ff;background:linear-gradient(145deg,#173b75,#682f9f);transform:translateX(3px)}.jw-rail span{color:#8beeff;height:27px}.jw-rail strong{font-size:9px}.jw-rail kbd{position:absolute;right:-7px;bottom:6px;border:1px solid #5e7892;background:#06172b;border-radius:4px;padding:1px 4px;font-size:7px}
+.jw-missions{position:fixed;right:16px;top:82px;width:300px;border-radius:18px;padding:10px 13px}.jw-missions header{display:flex;align-items:center;gap:8px;padding-bottom:8px;border-bottom:1px solid rgba(91,215,255,.3)}.jw-missions header>span{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;color:#05365b;background:#61eaff;text-shadow:none}.jw-missions header strong{font-size:12px}.jw-missions header button{margin-left:auto;border:0;background:none;color:#5fe3ff;font-size:9px;text-decoration:underline}.jw-missions p{display:grid;grid-template-columns:18px 1fr auto;align-items:center;gap:7px;margin:0;min-height:34px;border-bottom:1px solid rgba(104,202,235,.18);font-size:10px}.jw-missions p:last-child{border:0}.jw-check{width:14px;height:14px;border:1px solid #5edfff;border-radius:4px;display:grid;place-items:center;color:#032c37;font-size:9px}.jw-check.done{background:#42e7ad;box-shadow:0 0 8px rgba(66,231,173,.5)}.jw-missions b{font-size:8px;color:#72eaff}
+.jw-features{position:fixed;right:16px;top:247px;width:300px;display:grid;gap:8px}.jw-feature{height:58px;border-radius:16px;border:1px solid rgba(94,218,255,.8);display:grid;grid-template-columns:40px 1fr 12px;align-items:center;gap:9px;padding:7px 11px;text-align:left;background:linear-gradient(100deg,rgba(23,45,96,.97),rgba(67,38,128,.92));box-shadow:0 8px 20px rgba(0,0,0,.35)}.jw-feature.shop{border-color:#c262ff;background:linear-gradient(100deg,#351869,#81298e)}.jw-feature.explore{border-color:#47efb2;background:linear-gradient(100deg,#074a57,#147b63)}.jw-feature>span{height:38px;border-radius:11px;display:grid;place-items:center;color:#ffe16c;background:rgba(255,255,255,.08)}.jw-feature strong{display:grid;font-size:12px}.jw-feature small{font-size:8px;color:#c5dcea;margin-top:3px}.jw-feature>b{font-size:21px}.jw-feature:hover{transform:translateX(-3px);border-color:white}
+.jw-brand{position:fixed;left:22px;bottom:91px;width:225px;padding:10px 12px 11px 48px;background:linear-gradient(105deg,rgba(20,90,165,.88),rgba(38,111,188,.25),transparent);clip-path:polygon(0 0,86% 0,100% 50%,86% 100%,0 100%);display:grid}.jw-brand>span{position:absolute;left:12px;top:12px;color:#8ceeff}.jw-brand strong{font-size:15px}.jw-brand small{font-size:9px;color:#6de9ff;font-weight:800}.jw-brand em{font-size:6px;font-style:normal;color:#bad7e9;letter-spacing:.08em}
+.jw-dock{position:fixed;left:16px;bottom:14px;display:flex;gap:8px}.jw-dock button{min-width:72px;height:66px;border-radius:16px;border:2px solid #42dcff;background:linear-gradient(145deg,#06224a,#0b668f);display:grid;place-items:center;padding:5px 8px;position:relative;box-shadow:0 0 14px rgba(45,206,255,.25)}.jw-dock button:nth-child(2){border-color:#bb68ff;background:linear-gradient(145deg,#2c145b,#743196)}.jw-dock button:nth-child(3){border-color:#51ecaa;background:linear-gradient(145deg,#073f43,#147d5d)}.jw-dock span{height:27px;color:#a0efff}.jw-dock strong{font-size:10px}.jw-dock kbd{position:absolute;right:5px;bottom:4px;font-size:7px;color:#c4efff}.jw-dock button:hover{transform:translateY(-3px);border-color:#fff}
+.jw-chat{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);width:min(380px,calc(100vw - 590px));height:46px;border:2px solid rgba(68,208,255,.78);border-radius:17px;background:rgba(5,22,49,.93);display:grid;grid-template-columns:25px 1fr 18px;align-items:center;padding:0 12px;text-align:left}.jw-chat span{color:#76eaff}.jw-chat em{font-style:normal;color:#afc6d7;font-size:10px}.jw-chat b{font-size:18px}
+.jw-move{position:fixed;right:20px;bottom:45px;display:flex;gap:10px}.jw-move div{width:72px;height:72px;border-radius:50%;border:2px solid rgba(76,217,255,.75);background:radial-gradient(circle at 35% 25%,#1c5488,#05162f);display:grid;place-items:center;padding:6px;box-shadow:0 8px 19px rgba(0,0,0,.38)}.jw-move span{height:28px}.jw-move strong{font-size:9px}.jw-move kbd{font-size:7px;background:#07172a;border-radius:4px;padding:2px 4px}
+.jw-status{position:fixed;right:16px;bottom:10px;display:flex;align-items:center;gap:6px;font-size:8px;color:#d3e7f4}.jw-status i{width:8px;height:8px;border-radius:50%;background:#39ff8c;box-shadow:0 0 8px #39ff8c}.jw-status b{width:1px;height:10px;background:#6d8697}.jw-status span:first-of-type{color:#72ffad;font-weight:900}
+.jw-modal{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:min(460px,calc(100vw - 30px));min-height:220px;border-radius:22px;padding:20px;pointer-events:auto}.jw-modal:before{content:"";position:fixed;inset:-100vh -100vw;background:rgba(0,8,20,.42);z-index:-1;backdrop-filter:blur(2px)}.jw-modal>button{position:absolute;right:12px;top:12px;width:32px;height:32px;border-radius:9px;border:1px solid #5fcde9;background:#0c4669}.jw-modal small{color:#68e8ff;font-size:8px;font-weight:900;letter-spacing:.15em}.jw-modal h2{margin:4px 0 14px;font-size:22px}.jw-modal p{font-size:11px;color:#bfd7e7;line-height:1.5}.jw-guide{display:grid;grid-template-columns:1fr 1fr;gap:8px}.jw-guide span{padding:8px;border:1px solid rgba(89,210,245,.22);border-radius:9px;background:rgba(30,102,137,.13);font-size:10px}.jw-guide kbd{color:#86edff;margin-right:7px}.jw-error{color:#ffadb6!important}
+@media(max-width:900px){.jw-profile{width:250px;height:66px;padding-left:62px}.jw-avatar{width:56px;height:56px}.jw-profile strong{font-size:14px}.jw-profile em{display:none}.jw-wallet{min-width:125px}.jw-missions,.jw-features{width:236px}.jw-missions{top:72px}.jw-features{top:220px}.jw-feature{height:50px}.jw-rail{top:94px}.jw-rail button{width:52px;height:52px}.jw-brand,.jw-move,.jw-status{display:none}.jw-chat{left:auto;right:12px;transform:none;width:270px}.jw-dock button{min-width:62px;height:58px}}
+@media(max-width:620px){.jw-missions,.jw-features{display:none}.jw-profile{width:200px}.jw-profile span,.jw-top button:nth-last-child(2){display:none}.jw-wallet{min-width:100px}.jw-rail{top:auto;bottom:78px;grid-template-columns:repeat(5,1fr)}.jw-rail button{width:47px;height:45px}.jw-rail strong,.jw-rail kbd,.jw-chat{display:none}.jw-guide{grid-template-columns:1fr}}
+`;
+
+export default function JarvisPremiumHud() {
+  const {state, setState} = useContext(AppContext);
+  const identity = useContext(JarvisIdentityContext);
+  const [panel, setPanel] = useState(null);
+  const [remote, setRemote] = useState(null);
+  const chatOpen = state.openedPanel === 'ChatPanel';
+  const displayName = identity?.profile?.display_name || identity?.user?.display_name || identity?.user?.username || 'Jogador';
+  const username = identity?.user?.username || 'jarvis';
+  const avatar = identity?.profile?.avatar_url || identity?.user?.avatar_url || '';
+  const coins = new Intl.NumberFormat('pt-BR').format(Number(identity?.wallet?.balance) || 0);
+
+  const openChat = () => {
+    setPanel(null);
+    setState({openedPanel: chatOpen ? null : 'ChatPanel'});
+  };
+
+  const openPanel = async id => {
+    if (id === 'social') return openChat();
+    const next = panel === id ? null : id;
+    setPanel(next);
+    if (next !== 'daily' && next !== 'shop') return;
+    setRemote({loading: true});
+    try {
+      const data = next === 'daily' ? await activityApi.daily() : await activityApi.shop();
+      setRemote({data});
+    } catch (error) {
+      setRemote({error: error?.message || 'Servico indisponivel.'});
+    }
+  };
+
+  const title = {
+    map: 'Mapa da cidade',
+    daily: 'Daily Jarvis',
+    shop: 'Loja Jarvis',
+    guide: 'Como jogar',
+    events: 'Eventos Jarvis',
+    settings: 'Configuracoes',
+  }[panel];
+
+  return <nav className="jw-hud" aria-label="HUD Jarvis World">
+    <style>{css}</style>
+
+    <section className="jw-profile jw-panel">
+      <div className="jw-avatar">{avatar ? <img src={avatar} alt="" /> : displayName.slice(0, 1).toUpperCase()}</div>
+      <div><strong>{displayName}</strong><span>@{username}</span><em>JARVIS CITY · SOCIAL</em></div>
+    </section>
+
+    <section className="jw-top">
+      <div className="jw-wallet"><span className="jw-coin"><Icon name="coin" size={25}/></span><strong>{coins}</strong><small>JC</small></div>
+      <button type="button" onClick={openChat} aria-label="Social"><Icon name="users"/></button>
+      <button type="button" onClick={() => void openPanel('events')} aria-label="Eventos"><Icon name="event"/></button>
+      <button type="button" onClick={() => void openPanel('settings')} aria-label="Configuracoes"><Icon name="gear"/></button>
+    </section>
+
+    <section className="jw-rail">
+      {navItems.map(([id, icon, label, key]) => <button key={id} type="button" className={panel === id ? 'active' : ''} onClick={() => void openPanel(id)}>
+        <span><Icon name={icon} size={23}/></span><strong>{label}</strong><kbd>{key}</kbd>
+      </button>)}
+    </section>
+
+    <section className="jw-missions jw-panel">
+      <header><span><Icon name="target" size={20}/></span><strong>ATIVIDADES SOCIAIS</strong><button type="button" onClick={() => void openPanel('daily')}>Ver todas</button></header>
+      <p><i className="jw-check done">✓</i><span>Explore a Jarvis Plaza</span><b>ATIVO</b></p>
+      <p><i className="jw-check"/><span>Converse com outros jogadores</span><b>CHAT</b></p>
+      <p><i className="jw-check"/><span>Descubra os distritos da cidade</span><b>MAPA</b></p>
+    </section>
+
+    <section className="jw-features">
+      <button type="button" className="jw-feature" onClick={() => void openPanel('events')}><span><Icon name="event" size={28}/></span><strong>EVENTOS<small>Temporadas e encontros</small></strong><b>›</b></button>
+      <button type="button" className="jw-feature shop" onClick={() => void openPanel('shop')}><span><Icon name="shop" size={28}/></span><strong>LOJA<small>Itens, skins e novidades</small></strong><b>›</b></button>
+      <button type="button" className="jw-feature explore" onClick={() => void openPanel('map')}><span><Icon name="guide" size={28}/></span><strong>EXPLORAR<small>Landmarks e distritos</small></strong><b>›</b></button>
+    </section>
+
+    <section className="jw-brand"><span><Icon name="crown" size={30}/></span><strong>JARVIS WORLD</strong><small>JARVIS CITY</small><em>JOGUE · EXPLORE · FACA AMIGOS</em></section>
+
+    <section className="jw-dock">
+      <button type="button" onClick={openChat}><span><Icon name="chat" size={25}/></span><strong>Chat</strong><kbd>T</kbd></button>
+      <button type="button" onClick={() => window.dispatchEvent(new Event('jarvis-open-emotes'))}><span><Icon name="smile" size={25}/></span><strong>Emotes</strong><kbd>Q</kbd></button>
+      <button type="button" onClick={() => void openPanel('guide')}><span><Icon name="map" size={25}/></span><strong>Guia</strong><kbd>G</kbd></button>
+    </section>
+
+    <button type="button" className="jw-chat" onClick={openChat}><span><Icon name="chat" size={18}/></span><em>Digite uma mensagem...</em><b>›</b></button>
+
+    <section className="jw-move">
+      <div><span><Icon name="run" size={30}/></span><strong>Correr</strong><kbd>SHIFT</kbd></div>
+      <div><span><Icon name="jump" size={30}/></span><strong>Pular</strong><kbd>ESPACO</kbd></div>
+    </section>
+
+    <footer className="jw-status"><i/><span>ONLINE</span><b/><span>Discord Activity</span><b/><strong>Jarvis City · Social</strong></footer>
+
+    {panel && <section className="jw-modal jw-panel">
+      <button type="button" onClick={() => setPanel(null)} aria-label="Fechar">×</button>
+      <small>JARVIS WORLD</small><h2>{title}</h2>
+      {panel === 'guide' && <div className="jw-guide"><span><kbd>WASD</kbd>Mover</span><span><kbd>SHIFT</kbd>Correr</span><span><kbd>ESPACO</kbd>Pular</span><span><kbd>Q</kbd>Emotes</span><span><kbd>ENTER</kbd>Chat</span><span><kbd>'</kbd>Camera</span></div>}
+      {panel === 'map' && <p>Explore Jarvis Plaza e os distritos da cidade pelo mapa social.</p>}
+      {panel === 'events' && <p>Temporadas, encontros e eventos da comunidade aparecem aqui.</p>}
+      {panel === 'settings' && <p>Preferencias da sessao e integracao com a Discord Activity.</p>}
+      {(panel === 'daily' || panel === 'shop') && remote?.loading && <p>Carregando...</p>}
+      {(panel === 'daily' || panel === 'shop') && remote?.error && <p className="jw-error">{remote.error}</p>}
+      {panel === 'daily' && remote?.data && <p>{remote.data?.daily?.eligible ? 'Daily disponivel para resgate.' : 'Daily ja coletado neste periodo.'}</p>}
+      {panel === 'shop' && remote?.data && <p>{remote.data?.shop?.total ?? remote.data?.shop?.items?.length ?? 0} itens disponiveis no catalogo.</p>}
+    </section>}
+  </nav>;
+}
