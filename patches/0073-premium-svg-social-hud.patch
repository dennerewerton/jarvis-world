+.move{position:fixed;right:26px;bottom:42px;display:flex;gap:16px}.move div{display:grid;place-items:center;width:98px;height:98px;padding:9px;border:2px solid #49d9ffbf;border-radius:50%;background:radial-gradient(circle at 35% 25%,#1f4e81f0,#05142bf7);box-shadow:0 9px 23px #0007}.move strong{font-size:11px}.move kbd{padding:2px 6px;border-radius:4px;background:#08192e;font-size:8px}
+.modal{position:fixed;left:50%;top:50%;width:min(540px,calc(100vw - 40px));min-height:260px;padding:26px;transform:translate(-50%,-50%);border:2px solid #50e1ffe0;border-radius:24px;background:linear-gradient(145deg,#05142dfc,#0a375bfa);box-shadow:0 22px 70px #000a}.modal>small{color:#68e8ff;font-size:9px;font-weight:900;letter-spacing:.17em}.modal h2{margin:5px 0 18px;font-size:28px;text-transform:uppercase}.modal p{color:#c3d7e4;line-height:1.6}.close{position:absolute;top:14px;right:14px;width:36px;height:36px;border:1px solid #71e2ff80;border-radius:10px;background:#17507599}.guide{display:grid;grid-template-columns:1fr 1fr;gap:10px}.guide span{display:flex;align-items:center;gap:9px;padding:11px;border:1px solid #59d2f538;border-radius:10px;background:#1e668921;font-size:12px}.guide kbd{min-width:58px;color:#86edff;font-size:9px}.error{color:#ffadb6!important}
