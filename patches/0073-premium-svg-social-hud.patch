diff --git a/src/JarvisPremiumHud.jsx b/src/JarvisPremiumHud.jsx
new file mode 100644
--- /dev/null
+++ b/src/JarvisPremiumHud.jsx
@@ -0,0 +1,91 @@
+import React, {useContext, useState} from 'react';
+import {AppContext} from './components/app';
+import {activityApi} from './jarvis-compat/activity-api.mjs';
+import {JarvisIdentityContext} from './jarvis-compat/ActivityShell.jsx';
+import styles from './JarvisPremiumHud.module.css';
+
+const money = value => new Intl.NumberFormat('pt-BR').format(Number(value) || 0);
+const paths = {
+  map: <><path d="M3 6l5-3 8 3 5-3v15l-5 3-8-3-5 3z"/><path d="M8 3v15M16 6v15"/></>,
+  users: <><circle cx="9" cy="8" r="3"/><path d="M3 19c.5-3.5 2.5-5.5 6-5.5s5.5 2 6 5.5"/><circle cx="17.5" cy="9" r="2"/><path d="M16 14c2.8-.3 4.5 1.2 5 4"/></>,
+  daily: <><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4M17 3v4M3 10h18"/><path d="m8 15 2 2 5-5"/></>,
+  shop: <><path d="M4 10h16l-1-5H5z"/><path d="M5 10v10h14V10M9 20v-6h6v6"/></>,
+  guide: <><circle cx="12" cy="12" r="9"/><path d="m16 8-3 6-6 3 3-6z"/></>,
+  gear: <><circle cx="12" cy="12" r="3"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/></>,
+  mail: <><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></>,
+  event: <><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4M17 3v4M3 10h18"/><path d="m12 12 1 2 2 .3-1.5 1.5.4 2.2-1.9-1-1.9 1 .4-2.2L9 14.3l2-.3z"/></>,
+  chat: <><path d="M4 5h16v12H9l-5 3z"/><path d="M8 11h.1M12 11h.1M16 11h.1"/></>,
+  smile: <><circle cx="12" cy="12" r="9"/><path d="M8 14c1 2 2.4 3 4 3s3-1 4-3M8.5 9h.1M15.5 9h.1"/></>,
+  run: <><circle cx="15" cy="4" r="2"/><path d="m13 8-3 4 4 2 1 6M13 8l4 2 3-1M10 12l-3 5-3 1M14 14l-4 5"/></>,
+  jump: <><path d="M12 20V5m-6 6 6-6 6 6M5 20h14"/></>,
+  crown: <><path d="m4 8 4 3 4-6 4 6 4-3-2 10H6zM6 18h12"/></>,
+  target: <><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v4M22 12h-4M12 22v-4M2 12h4"/></>,
+  coin: <><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="6"/><path d="M15 9c-1-.8-5-1.2-5 1 0 2 5 1 5 4 0 2-4 2-6 1M12 7v10"/></>,
+};
+const Icon = ({name, size=26}) => <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.9" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">{paths[name] || paths.guide}</svg>;
+const nav = [['map','map','Mapa','M'],['social','users','Social','P'],['daily','daily','Daily','D'],['shop','shop','Loja','L'],['guide','guide','Guia','G']];
+
+export default function JarvisPremiumHud() {
+  const {state, setState} = useContext(AppContext);
+  const identity = useContext(JarvisIdentityContext);
+  const [panel, setPanel] = useState(null);
+  const [remote, setRemote] = useState(null);
+  const chatOpen = state.openedPanel === 'ChatPanel';
+  const name = identity?.profile?.display_name || identity?.user?.display_name || identity?.user?.username || 'Jogador';
+  const username = identity?.user?.username || 'jarvis';
+  const avatar = identity?.profile?.avatar_url || identity?.user?.avatar_url || '';
+  const openChat = () => { setPanel(null); setState({openedPanel: chatOpen ? null : 'ChatPanel'}); };
+  const open = async id => {
+    if (id === 'social') return openChat();
+    const next = panel === id ? null : id;
+    setPanel(next);
+    if (next !== 'daily' && next !== 'shop') return;
+    setRemote({loading:true});
+    try { setRemote({data: next === 'daily' ? await activityApi.daily() : await activityApi.shop()}); }
+    catch (error) { setRemote({error:error?.message || 'Servico indisponivel.'}); }
+  };
+  const title = {map:'Mapa da cidade',daily:'Daily Jarvis',shop:'Loja Jarvis',guide:'Como jogar',events:'Eventos Jarvis',settings:'Configuracoes'}[panel];
+
+  return <nav className={styles.hud} aria-label="HUD Jarvis World">
+    <section className={styles.profile}>
+      <div className={styles.avatar}>{avatar ? <img src={avatar} alt="" /> : name.slice(0,1).toUpperCase()}</div>
+      <div><strong>{name}</strong><span>@{username}</span><em>JARVIS CITY · SOCIAL</em></div>
+    </section>
+    <section className={styles.top}>
+      <div className={styles.wallet}><span><Icon name="coin" size={30}/></span><strong>{money(identity?.wallet?.balance)}</strong><small>JC</small></div>
+      <button onClick={() => open('social')} aria-label="Social"><Icon name="users"/></button>
+      <button onClick={() => open('events')} aria-label="Eventos"><Icon name="event"/></button>
+      <button onClick={() => open('settings')} aria-label="Configuracoes"><Icon name="gear"/></button>
+    </section>
+    <section className={styles.rail}>{nav.map(([id,icon,label,key]) => <button key={id} className={panel===id?styles.active:''} onClick={() => open(id)}><span><Icon name={icon}/></span><strong>{label}</strong><kbd>{key}</kbd></button>)}</section>
+    <section className={styles.missions}>
+      <header><Icon name="target" size={23}/><strong>MISSÕES DIÁRIAS</strong><button onClick={() => open('daily')}>Ver todas</button></header>
+      <p><i className={styles.done}>✓</i><span>Entre no Jarvis World</span><b>1/1</b></p>
+      <p><i/><span>Explore a cidade</span><b>0/1</b></p>
+      <p><i/><span>Converse com jogadores</span><b>0/3</b></p>
+    </section>
+    <section className={styles.cards}>
+      <button className={styles.event} onClick={() => open('events')}><span><Icon name="event" size={31}/></span><strong>EVENTOS<small>Participe e ganhe premios!</small></strong><b>›</b></button>
+      <button className={styles.shop} onClick={() => open('shop')}><span><Icon name="shop" size={31}/></span><strong>LOJA<small>Itens, skins e muito mais!</small></strong><b>›</b></button>
+      <button className={styles.explore} onClick={() => open('map')}><span><Icon name="guide" size={31}/></span><strong>EXPLORAR<small>Landmarks e distritos</small></strong><b>›</b></button>
+    </section>
+    <section className={styles.brand}><Icon name="crown" size={34}/><strong>JARVIS WORLD</strong><small>JARVIS CITY</small><em>JOGUE · CONQUISTE · FACA AMIGOS</em></section>
+    <section className={styles.dock}>
+      <button className={chatOpen?styles.active:''} onClick={openChat}><Icon name="chat" size={29}/><strong>Chat</strong><kbd>T</kbd></button>
+      <button onClick={() => window.dispatchEvent(new Event('jarvis-open-emotes'))}><Icon name="smile" size={29}/><strong>Emotes</strong><kbd>Q</kbd></button>
+      <button onClick={() => open('guide')}><Icon name="map" size={29}/><strong>Guia</strong><kbd>G</kbd></button>
+    </section>
+    <button className={styles.chat} onClick={openChat}><Icon name="chat" size={20}/><em>Digite uma mensagem...</em><b>›</b></button>
+    <section className={styles.move}><div><Icon name="run" size={36}/><strong>Correr</strong><kbd>SHIFT</kbd></div><div><Icon name="jump" size={36}/><strong>Pular</strong><kbd>ESPACO</kbd></div></section>
+    {panel && <section className={styles.modal}><button className={styles.close} onClick={() => setPanel(null)}>×</button><small>JARVIS WORLD</small><h2>{title}</h2>
+      {panel==='guide' && <div className={styles.guide}><span><kbd>WASD</kbd>Mover</span><span><kbd>SHIFT</kbd>Correr</span><span><kbd>ESPACO</kbd>Pular</span><span><kbd>'</kbd>Camera</span></div>}
+      {panel==='map' && <p>Explore a Jarvis Plaza e os distritos da cidade.</p>}
+      {panel==='events' && <p>Temporadas, encontros e eventos da comunidade aparecem aqui.</p>}
+      {panel==='settings' && <p>Configuracoes da sessao Jarvis World.</p>}
+      {(panel==='daily'||panel==='shop') && remote?.loading && <p>Carregando...</p>}
+      {remote?.error && <p className={styles.error}>{remote.error}</p>}
+      {panel==='daily' && remote?.data && <p>{remote.data?.daily?.eligible ? 'Daily disponivel para resgate.' : 'Daily ja coletado.'}</p>}
+      {panel==='shop' && remote?.data && <p>{remote.data?.shop?.total ?? remote.data?.shop?.items?.length ?? 0} itens no catalogo.</p>}
+    </section>}
+  </nav>;
+}
diff --git a/src/JarvisPremiumHud.module.css b/src/JarvisPremiumHud.module.css
