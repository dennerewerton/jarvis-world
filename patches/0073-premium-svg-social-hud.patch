+.profile{position:fixed;top:22px;left:22px;display:flex;align-items:center;width:420px;min-height:92px;padding:12px 30px 12px 104px;border:2px solid #53e1ffe6;border-radius:24px 20px 34px 24px;background:linear-gradient(115deg,#061d46fa,#11599de8);box-shadow:0 14px 35px #00081d80,inset 0 0 24px #54d6ff26}.avatar{position:absolute;left:-8px;display:grid;place-items:center;width:90px;height:90px;overflow:hidden;border:5px solid #77ebff;border-radius:50%;background:radial-gradient(circle at 35% 30%,#976fff,#164d99 70%);box-shadow:0 0 0 6px #7d50ff8c,0 0 22px #46dcffcc;font-size:32px;font-weight:900}.avatar img{width:100%;height:100%;object-fit:cover}.profile>div:last-child{display:grid;gap:2px;min-width:0}.profile strong{overflow:hidden;font-size:25px;line-height:1;text-overflow:ellipsis;text-transform:uppercase;white-space:nowrap}.profile span{color:#c8e4f8;font-size:14px}.profile em{margin-top:6px;color:#79edff;font-size:9px;font-style:normal;font-weight:900;letter-spacing:.12em}
+.top{position:fixed;top:22px;right:22px;display:flex;align-items:center;gap:10px}.wallet{display:flex;align-items:center;min-width:225px;height:58px;padding:0 16px;gap:10px;border:2px solid #41efadcc;border-radius:22px;background:linear-gradient(145deg,#05162bfa,#075651e6);box-shadow:0 10px 25px #0006}.wallet>span{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;color:#ffdf42;background:radial-gradient(circle,#ffda3d,#c66b00);box-shadow:inset 0 0 0 3px #ffe26c,0 0 12px #ffc62380}.wallet strong{margin-left:auto;font-size:23px}.wallet small{color:#96ffd8;font-weight:900}.top>button{display:grid;place-items:center;width:56px;height:56px;border:1px solid #54deffbf;border-radius:16px;background:linear-gradient(145deg,#082e58fa,#086191eb);box-shadow:0 8px 20px #0005}.top>button:hover{transform:translateY(-2px);border-color:#fff}
+.rail{position:fixed;top:155px;left:22px;display:grid;gap:10px}.rail button{position:relative;display:grid;place-items:center;width:78px;min-height:76px;padding:8px 5px;border:1px solid #49daffbf;border-radius:18px;background:linear-gradient(145deg,#051e3ef7,#0d527eed);box-shadow:0 8px 19px #0006}.rail button>span{display:grid;place-items:center;width:38px;height:38px;color:#8ceeff}.rail strong{font-size:11px}.rail kbd{position:absolute;right:-8px;bottom:8px;padding:2px 5px;border:1px solid #ffffff59;border-radius:5px;background:#071a34;font-size:8px}.rail button:hover,.rail button.active{border-color:#c57bff;background:linear-gradient(145deg,#143261fa,#5e2897f0);transform:translateX(3px)}
+.missions{position:fixed;top:100px;right:22px;width:380px;padding:14px 16px;border:2px solid #46dcffd1;border-radius:20px;background:linear-gradient(145deg,#051530f5,#083f68e6);box-shadow:0 12px 28px #0007}.missions header{display:grid;grid-template-columns:30px 1fr auto;align-items:center;gap:9px;padding-bottom:9px;border-bottom:1px solid #68deff59;color:#69eaff}.missions header strong{color:#fff;font-size:15px}.missions header button{padding:0;border:0;color:#75eaff;background:none;font-size:10px;text-decoration:underline}.missions p{display:grid;grid-template-columns:22px 1fr auto;align-items:center;gap:9px;min-height:42px;margin:0;border-bottom:1px solid #64c8eb2e;font-size:12px}.missions p:last-child{border:0}.missions i{display:grid;place-items:center;width:16px;height:16px;border:1px solid #60dfff;border-radius:4px;font-style:normal}.missions i.done{color:#053b2d;background:#4af3a9;box-shadow:0 0 10px #42efad8c}.missions p b{color:#86ebff;font-size:10px}
+.cards{position:fixed;top:310px;right:22px;display:grid;width:380px;gap:11px}.cards button{display:grid;grid-template-columns:52px 1fr 16px;align-items:center;min-height:76px;padding:10px 16px;gap:11px;border:1px solid #60dcffb8;border-radius:18px;box-shadow:0 9px 23px #0006,inset 0 0 16px #6d4aff2e;text-align:left}.cards button>span{display:grid;place-items:center;width:46px;height:46px;border-radius:13px;background:#ffffff14}.cards strong{display:grid;gap:4px;font-size:16px}.cards small{color:#d0e0ef;font-size:10px;font-weight:600}.cards button>b{font-size:28px}.cards button:hover{transform:translateX(-3px);border-color:#fff}.event{background:linear-gradient(105deg,#1b2961f7,#4f2789eb)}.event>span{color:#70dfff}.shop{background:linear-gradient(105deg,#371868f7,#8b268feb)}.shop>span{color:#ffe363}.explore{background:linear-gradient(105deg,#064556f7,#117d62eb)}.explore>span{color:#6affbd}
+.brand{position:fixed;left:30px;bottom:122px;display:grid;width:300px;padding:15px 20px 16px 65px;border-top:1px solid #69e4ffbf;background:linear-gradient(110deg,#114f9ae6,#236ab770,transparent);clip-path:polygon(0 0,87% 0,100% 50%,87% 100%,0 100%)}.brand>svg{position:absolute;left:18px;top:16px;color:#9ff2ff}.brand strong{font-size:21px}.brand small{color:#75eaff;font-size:11px;font-weight:800;letter-spacing:.09em}.brand em{margin-top:3px;color:#c5dcea;font-size:8px;font-style:normal}
