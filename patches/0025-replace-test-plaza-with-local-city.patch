@@ -0,0 +1,39 @@
+import * as THREE from 'three';
+import metaversefile from 'metaversefile';
+
+const {useApp, useCleanup, usePhysics} = metaversefile;
+
+export default () => {
+  const app = useApp();
+  const physics = usePhysics();
+  const floorSize = 160;
+
+  const sky = new THREE.Mesh(
+    new THREE.SphereGeometry(120, 28, 18),
+    new THREE.MeshBasicMaterial({color: 0x132c47, side: THREE.BackSide}),
+  );
+  sky.position.y = 42;
+  sky.frustumCulled = false;
+  app.add(sky);
+
+  const ground = new THREE.Mesh(
+    new THREE.BoxGeometry(floorSize, 0.5, floorSize),
+    new THREE.MeshStandardMaterial({color: 0x263e52, roughness: 0.92}),
+  );
+  ground.position.set(0, -0.25, 0);
+  ground.receiveShadow = true;
+  app.add(ground);
+
+  const floorPhysicsId = physics.addBoxGeometry(
+    new THREE.Vector3(0, -0.25, 0),
+    new THREE.Quaternion(),
+    new THREE.Vector3(floorSize / 2, 0.25, floorSize / 2),
+    false,
+  );
+
+  useCleanup(() => {
+    physics.removeGeometry(floorPhysicsId);
+  });
+
+  return app;
+};
