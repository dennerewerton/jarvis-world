diff --git a/jarvis-cosmetics-runtime.js b/jarvis-cosmetics-runtime.js
new file mode 100644
index 0000000..9c1f056
--- /dev/null
+++ b/jarvis-cosmetics-runtime.js
@@ -0,0 +1,197 @@
+import * as THREE from 'three';
+import * as SkeletonUtils from 'three/examples/jsm/utils/SkeletonUtils.js';
+import loaders from './loaders.js';
+
+const catalog = new Map();
+const sourceCache = new Map();
+const playerState = new WeakMap();
+const MAX_CONCURRENT_WEARABLES = 8;
+const MAX_CACHED_SOURCES = 16;
+const COSMETIC_PLAYER_KEY = 'jarvisCosmetics';
+
+const boneKeys = {
+  Bone: 'Root',
+  J_Bip_C_Hips: 'Hips', J_Bip_C_Spine: 'Spine', J_Bip_C_Chest: 'Chest',
+  J_Bip_C_UpperChest: 'UpperChest', J_Bip_C_Neck: 'Neck', J_Bip_C_Head: 'Head',
+  J_Adj_L_FaceEye: 'Eye_L', J_Adj_R_FaceEye: 'Eye_R',
+  J_Bip_L_Shoulder: 'Left_shoulder', J_Bip_L_UpperArm: 'Left_arm', J_Bip_L_LowerArm: 'Left_elbow', J_Bip_L_Hand: 'Left_wrist',
+  J_Bip_R_Shoulder: 'Right_shoulder', J_Bip_R_UpperArm: 'Right_arm', J_Bip_R_LowerArm: 'Right_elbow', J_Bip_R_Hand: 'Right_wrist',
+  J_Bip_L_UpperLeg: 'Left_leg', J_Bip_L_LowerLeg: 'Left_knee', J_Bip_L_Foot: 'Left_ankle', J_Bip_L_ToeBase: 'Left_toe',
+  J_Bip_R_UpperLeg: 'Right_leg', J_Bip_R_LowerLeg: 'Right_knee', J_Bip_R_Foot: 'Right_ankle', J_Bip_R_ToeBase: 'Right_toe',
+  J_Sec_L_Bust1: 'UpperChest', J_Sec_L_Bust2: 'UpperChest', J_Sec_R_Bust1: 'UpperChest', J_Sec_R_Bust2: 'UpperChest',
+};
+
+for (const side of ['L', 'R']) {
+  const target = side === 'L' ? 'Left' : 'Right';
+  for (const finger of ['Index', 'Little', 'Middle', 'Ring', 'Thumb']) {
+    for (const number of [1, 2, 3]) boneKeys[`J_Bip_${side}_${finger}${number}`] = `${target}_${finger.toLowerCase()}Finger${number}`;
+  }
+  boneKeys[`J_Bip_${side}_Thumb1`] = `${target}_thumb0`;
+  boneKeys[`J_Bip_${side}_Thumb2`] = `${target}_thumb1`;
+  boneKeys[`J_Bip_${side}_Thumb3`] = `${target}_thumb2`;
+}
+
+const parseIds = raw => {
+  try {
+    const ids = JSON.parse(String(raw || '[]'));
+    return Array.isArray(ids) ? ids.filter(value => typeof value === 'string').slice(0, MAX_CONCURRENT_WEARABLES) : [];
+  } catch {
+    return [];
+  }
+};
+
+const removeActive = state => {
+  for (const record of state.objects || []) {
+    record.object.removeFromParent();
+    releaseSource(record.assetPath);
+  }
+  state.objects = [];
+  trimSourceCache();
+};
+
+const loadSource = async definition => {
+  let entry = sourceCache.get(definition.asset_path);
+  if (!entry) {
+    entry = {refs: 0, source: null, usedAt: Date.now()};
+    entry.promise = loaders.gltfLoader.loadAsync(definition.asset_path).then(source => {
+      entry.source = source;
+      entry.usedAt = Date.now();
+      return source;
+    }).catch(error => {
+      if (sourceCache.get(definition.asset_path) === entry) sourceCache.delete(definition.asset_path);
+      throw error;
+    });
+    sourceCache.set(definition.asset_path, entry);
+  }
+  const source = await entry.promise;
+  entry.usedAt = Date.now();
+  return {entry, source};
+};
+
+const disposeMaterial = material => {
+  for (const value of Object.values(material || {})) {
+    if (value?.isTexture) value.dispose();
+  }
+  material?.dispose?.();
+};
+
+const disposeSource = source => source?.scene?.traverse(object => {
+  object.geometry?.dispose?.();
+  for (const material of Array.isArray(object.material) ? object.material : [object.material]) disposeMaterial(material);
+});
+
+const trimSourceCache = () => {
+  const disposable = Array.from(sourceCache.entries())
+    .filter(([, entry]) => entry.source && entry.refs === 0)
+    .sort(([, left], [, right]) => left.usedAt - right.usedAt);
+  while (sourceCache.size > MAX_CACHED_SOURCES && disposable.length) {
+    const [assetPath, entry] = disposable.shift();
+    sourceCache.delete(assetPath);
+    disposeSource(entry.source);
+  }
+};
+
+const retainSource = assetPath => {
+  const entry = sourceCache.get(assetPath);
+  if (entry) entry.refs += 1;
+};
+
+const releaseSource = assetPath => {
+  const entry = sourceCache.get(assetPath);
+  if (entry) entry.refs = Math.max(0, entry.refs - 1);
+};
+
+const targetBone = (avatar, sourceBone) => avatar.modelBones?.[boneKeys[sourceBone.name]] || null;
+
+const mountSkinned = (avatar, source) => {
+  const clone = SkeletonUtils.clone(source.scene);
+  avatar.model.updateMatrixWorld(true);
+  clone.traverse(object => {
+    if (!object.isSkinnedMesh) return;
+    const bones = object.skeleton.bones.map(bone => targetBone(avatar, bone));
+    if (bones.some(bone => !bone)) throw new Error('cosmetic_rig_incompatible');
+    const skeleton = new THREE.Skeleton(bones);
+    skeleton.calculateInverses();
+    object.bind(skeleton, new THREE.Matrix4());
+    object.frustumCulled = false;
+  });
+  avatar.model.add(clone);
+  return clone;
+};
+
+const mountAttachment = (avatar, source, definition) => {
+  const clone = SkeletonUtils.clone(source.scene);
+  const bone = definition.attachment?.bone === 'leftHand'
+    ? avatar.modelBones?.Left_wrist
+    : avatar.modelBones?.Head || avatar.modelBones?.Chest;
+  if (!bone) throw new Error('cosmetic_attachment_bone_missing');
+  bone.add(clone);
+  return clone;
+};
+
+export const registerCosmeticCatalog = items => {
+  catalog.clear();
+  for (const item of items || []) {
+    if (item && typeof item.id === 'string' && typeof item.asset_path === 'string') catalog.set(item.id, item);
+  }
+};
+
+export const publishLocalCosmetics = (player, ids) => {
+  if (!player?.playerMap) return;
+  const value = JSON.stringify(Array.from(new Set(ids)).slice(0, MAX_CONCURRENT_WEARABLES));
+  if (player.playersArray?.doc) player.playersArray.doc.transact(() => player.playerMap.set(COSMETIC_PLAYER_KEY, value));
+  else player.playerMap.set(COSMETIC_PLAYER_KEY, value);
+};
+
+const mountIds = (player, ids, stateKey, preview = false) => {
+  const avatar = player?.avatar;
+  const state = playerState.get(player) || {avatar: null, ids: '', catalogSize: -1, preview: false, objects: []};
+  if (!avatar?.model || (state.avatar === avatar && state.ids === stateKey && state.catalogSize === catalog.size && state.preview === preview)) return;
+  removeActive(state);
+  state.avatar = avatar;
+  state.ids = stateKey;
+  state.catalogSize = catalog.size;
+  state.preview = preview;
+  playerState.set(player, state);
+  for (const id of ids) {
+    const definition = catalog.get(id);
+    if (!definition || definition.render_kind === 'full_skin') continue;
+    loadSource(definition).then(({source}) => {
+      if (playerState.get(player) !== state || state.avatar !== player.avatar || state.ids !== stateKey || state.preview !== preview) return;
+      try {
+        const object = definition.render_kind === 'skinned'
+          ? mountSkinned(avatar, source)
+          : mountAttachment(avatar, source, definition);
+        retainSource(definition.asset_path);
+        state.objects.push({object, assetPath: definition.asset_path});
+        trimSourceCache();
+      } catch (error) {
+        console.warn(`Jarvis cosmetic ${id} was skipped.`, error);
+      }
+    }).catch(error => console.warn(`Jarvis cosmetic ${id} failed to load.`, error));
+  }
+};
+
+export const syncPlayerCosmetics = player => {
+  const rawIds = player?.playerMap?.get(COSMETIC_PLAYER_KEY) || '[]';
+  mountIds(player, parseIds(rawIds), rawIds, false);
+};
+
+export const previewPlayerCosmetics = (player, equippedIds, item) => {
+  const definition = catalog.get(item?.id) || item;
+  if (!definition?.id || definition.render_kind === 'full_skin') return;
+  const blockedSlots = new Set([definition.slot, ...(definition.conflicts || [])]);
+  const ids = Array.from(new Set(equippedIds || [])).filter(id => {
+    const current = catalog.get(id);
+    return current && !blockedSlots.has(current.slot) && !(current.conflicts || []).includes(definition.slot);
+  });
+  ids.push(definition.id);
+  const normalized = ids.slice(0, MAX_CONCURRENT_WEARABLES);
+  mountIds(player, normalized, `preview:${normalized.join(',')}`, true);
+};
+
+export const clearPlayerCosmetics = player => {
+  const state = playerState.get(player);
+  if (state) removeActive(state);
+  playerState.delete(player);
+};
