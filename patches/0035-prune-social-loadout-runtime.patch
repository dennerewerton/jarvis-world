+++ b/jarvis-social-loadout.js
@@ -0,0 +1,34 @@
+// Social-and-parkour builds do not equip gameplay items.  Keep this tiny
+// facade so historical game-manager calls are safe without loading the legacy
+// hotbar, inventory, object-sprite or infobox renderer dependency graph.
+class JarvisSocialLoadout extends EventTarget {
+  constructor() {
+    super();
+    this.selectedIndex = -1;
+  }
+
+  getHotbarRenderer() {
+    return null;
+  }
+
+  getInfoboxRenderer() {
+    return null;
+  }
+
+  getSelectedApp() {
+    return null;
+  }
+
+  setSelectedIndex() {
+    this.selectedIndex = -1;
+    return false;
+  }
+
+  getNextUsedIndex() {
+    return -1;
+  }
+
+  update() {}
+}
+
+export default new JarvisSocialLoadout();
