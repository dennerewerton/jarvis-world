diff --git a/src/jarvis-compat/jarvis-bridge.mjs b/src/jarvis-compat/jarvis-bridge.mjs
new file mode 100644
index 0000000..7d0bf56
--- /dev/null
+++ b/src/jarvis-compat/jarvis-bridge.mjs
@@ -0,0 +1,40 @@
+import {activityApi, ActivityApiError} from './activity-api.mjs';
+
+const payloadField = (payload, field) => {
+  const value = payload?.[field];
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    throw new ActivityApiError(
+      'invalid_response',
+      502,
+      'O Jarvis retornou dados incompletos para iniciar o mundo.',
+    );
+  }
+  return value;
+};
+
+export const jarvisBridge = Object.freeze({
+  async getCurrentUser() {
+    return payloadField(await activityApi.me(), 'user');
+  },
+  async getProfile() {
+    return payloadField(await activityApi.profile(), 'profile');
+  },
+  async getWallet() {
+    return payloadField(await activityApi.wallet(), 'wallet');
+  },
+  async getInventory() {
+    return payloadField(await activityApi.inventory(), 'inventory');
+  },
+  async getShop() {
+    return payloadField(await activityApi.shop(), 'shop');
+  },
+});
+
+export const loadJarvisIdentity = async () => {
+  const [user, profile, wallet] = await Promise.all([
+    jarvisBridge.getCurrentUser(),
+    jarvisBridge.getProfile(),
+    jarvisBridge.getWallet(),
+  ]);
+  return Object.freeze({user, profile, wallet});
+};
