+.identity {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin: 12px;
+  padding: 8px 10px;
+  max-width: min(320px, calc(100vw - 24px));
+  border: 1px solid rgba(116, 214, 255, 0.45);
+  border-radius: 12px;
+  background: rgba(4, 12, 24, 0.88);
+  box-shadow: 0 8px 26px rgba(0, 0, 0, 0.32);
+  color: #f4fbff;
+  font-family: Muli, sans-serif;
+  backdrop-filter: blur(10px);
+}
+
+.avatar {
+  width: 36px;
+  height: 36px;
+  border-radius: 50%;
+  object-fit: cover;
+}
+
+.copy {
+  display: flex;
+  min-width: 0;
+  flex: 1;
+  flex-direction: column;
+}
+
+.name,
+.balance {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.name {
+  font-size: 14px;
+}
+
+.balance {
+  color: #9edcf4;
+  font-size: 12px;
+}
+
+.verified {
+  display: grid;
+  width: 24px;
+  height: 24px;
+  flex: 0 0 24px;
+  place-items: center;
+  border-radius: 50%;
+  background: #68d6ff;
+  color: #06111d;
+  font-weight: 800;
+}
