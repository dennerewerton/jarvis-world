diff --git a/src/jarvis-compat/JarvisUser.jsx b/src/jarvis-compat/JarvisUser.jsx
new file mode 100644
index 0000000..b6b8047
--- /dev/null
+++ b/src/jarvis-compat/JarvisUser.jsx
@@ -0,0 +1,32 @@
+import React, {useContext} from 'react';
+
+import {JarvisIdentityContext} from './ActivityShell.jsx';
+import styles from './jarvis-user.module.css';
+
+const formatBalance = value => new Intl.NumberFormat('pt-BR').format(
+  Number.isFinite(Number(value)) ? Number(value) : 0,
+);
+
+export const JarvisUser = () => {
+  const identity = useContext(JarvisIdentityContext);
+  if (!identity) return null;
+
+  const displayName = identity.profile?.display_name
+    || identity.user?.display_name
+    || identity.user?.username
+    || 'Jogador';
+  const avatarUrl = identity.profile?.avatar_url || identity.user?.avatar_url || '';
+
+  return (
+    <section className={styles.identity} aria-label="Identidade Jarvis">
+      {avatarUrl && <img className={styles.avatar} src={avatarUrl} alt="" />}
+      <div className={styles.copy}>
+        <strong className={styles.name}>{displayName}</strong>
+        <span className={styles.balance}>
+          {formatBalance(identity.wallet?.balance)} Jarvis Coins
+        </span>
+      </div>
+      <span className={styles.verified} title="Identidade validada pelo Jarvis">J</span>
+    </section>
+  );
+};
