diff --git a/jarvis-three-compat.js b/jarvis-three-compat.js
new file mode 100644
--- /dev/null
+++ b/jarvis-three-compat.js
@@ -0,0 +1,30 @@
+import * as BaseThree from './packages/three/build/three.module.js';
+
+export * from './packages/three/build/three.module.js';
+
+// Webaverse is pinned to Three r134, which does not export CapsuleGeometry.
+// Some legacy client paths still ask for THREE.CapsuleGeometry. Keep one
+// browser-visible compatibility constructor at the Vite resolution boundary so
+// every bare `three` import receives the same safe API.
+class CapsuleGeometry extends BaseThree.CylinderGeometry {
+  constructor(radius = 1, length = 1, capSegments = 4, radialSegments = 8) {
+    const safeRadius = Number.isFinite(radius) ? Math.max(0, radius) : 1;
+    const safeLength = Number.isFinite(length) ? Math.max(0, length) : 1;
+    const safeRadialSegments = Number.isFinite(radialSegments)
+      ? Math.max(3, Math.floor(radialSegments))
+      : 8;
+    super(safeRadius, safeRadius, safeLength + safeRadius * 2, safeRadialSegments, 1, false);
+    this.type = 'CapsuleGeometry';
+    this.parameters = {
+      radius: safeRadius,
+      length: safeLength,
+      capSegments,
+      radialSegments: safeRadialSegments,
+    };
+  }
+}
+
+const ThreeCompat = {...BaseThree, CapsuleGeometry};
+
+export {CapsuleGeometry};
+export default ThreeCompat;
