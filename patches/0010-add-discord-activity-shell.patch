+    radial-gradient(circle at 82% 78%, rgb(0 202 214 / 18%), transparent 30rem),
+    #070b14;
+  font-family: Inter, Muli, ui-sans-serif, system-ui, sans-serif;
+}
+
+.grid {
+  position: absolute;
+  inset: 0;
+  opacity: 0.13;
+  background-image:
+    linear-gradient(rgb(103 232 249 / 35%) 1px, transparent 1px),
+    linear-gradient(90deg, rgb(103 232 249 / 35%) 1px, transparent 1px);
+  background-size: 46px 46px;
+  mask-image: radial-gradient(circle, black 0%, transparent 72%);
+}
+
+.card {
+  position: relative;
+  width: min(34rem, calc(100vw - 2rem));
+  box-sizing: border-box;
+  padding: 2.25rem;
+  border: 1px solid rgb(103 232 249 / 28%);
+  border-radius: 1.25rem;
+  background: rgb(11 18 32 / 88%);
+  box-shadow: 0 24px 80px rgb(0 0 0 / 45%);
+  text-align: center;
+  backdrop-filter: blur(18px);
+}
+
+.mark {
+  display: grid;
+  width: 4rem;
+  height: 4rem;
+  margin: 0 auto 1.25rem;
+  place-items: center;
+  border: 1px solid rgb(103 232 249 / 48%);
+  border-radius: 50%;
+  color: var(--jarvis-cyan);
+  background: rgb(88 166 255 / 12%);
+  box-shadow: 0 0 2.5rem rgb(88 166 255 / 24%);
+  font-size: 1.55rem;
+  font-weight: 700;
+}
+
+.eyebrow {
+  margin: 0 0 0.6rem;
+  color: var(--jarvis-cyan);
+  font-size: 0.78rem;
+  font-weight: 700;
+  letter-spacing: 0.2em;
+}
+
+.title {
+  margin: 0;
+  font-size: clamp(1.7rem, 4vw, 2.35rem);
+  line-height: 1.1;
+}
+
+.message {
+  min-height: 3rem;
+  margin: 1rem 0 0;
+  color: #b9c7dc;
+  font-size: 1rem;
+  line-height: 1.55;
+}
+
+.button {
+  margin-top: 1.25rem;
+  padding: 0.8rem 1.15rem;
+  border: 1px solid rgb(103 232 249 / 55%);
+  border-radius: 0.7rem;
+  color: #07111d;
+  background: linear-gradient(135deg, var(--jarvis-cyan), var(--jarvis-blue));
+  font: inherit;
+  font-weight: 700;
+  cursor: pointer;
+}
+
+.button:focus-visible {
+  outline: 3px solid #fff;
+  outline-offset: 3px;
+}
+
+.security {
+  position: absolute;
+  right: 1rem;
+  bottom: 1rem;
+  left: 1rem;
+  margin: 0;
+  color: #7890aa;
+  font-size: 0.78rem;
+  text-align: center;
+}
+
+@media (max-width: 520px) {
+  .card {
+    padding: 1.6rem 1.25rem;
+  }
+}
+
diff --git a/src/jarvis-compat/worlds-host.mjs b/src/jarvis-compat/worlds-host.mjs
new file mode 100644
index 0000000..e624a2e
--- /dev/null
+++ b/src/jarvis-compat/worlds-host.mjs
@@ -0,0 +1,8 @@
+export const resolveWorldsHost = locationLike => {
+  const {hostname, origin, port, protocol} = locationLike;
+  const isLoopback = hostname === '127.0.0.1' || hostname === 'localhost' || hostname === '::1';
+  if (protocol === 'https:' && !isLoopback) return origin + '/worlds/';
+  const currentPort = port ? parseInt(port, 10) : (protocol === 'https:' ? 443 : 80);
+  return protocol + '//' + hostname + ':' + (currentPort + 1) + '/worlds/';
+};
+

