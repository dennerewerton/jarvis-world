diff --git a/src/jarvis-compat/ActivityShell.jsx b/src/jarvis-compat/ActivityShell.jsx
new file mode 100644
index 0000000..0eb31d9
--- /dev/null
+++ b/src/jarvis-compat/ActivityShell.jsx
@@ -0,0 +1,153 @@
+import React, {useCallback, useEffect, useRef, useState} from 'react';
+import {activityApi, ActivityApiError, clearActivitySession} from './activity-api.mjs';
+import {authenticateDiscord, authorizeDiscord} from './activity-discord.js';
+import styles from './activity-shell.module.css';
+
+const stageCopy = {
+  checking: ['Verificando disponibilidade…', 'Preparando uma conexão segura com os serviços do Jarvis.'],
+  waiting_discord: ['Conectando ao Discord…', 'Aguardando a autorização da Activity.'],
+  exchanging: ['Confirmando sua identidade…', 'Validando o acesso ao servidor e criando sua sessão Jarvis.'],
+  loading_profile: ['Carregando seu perfil…', 'Buscando apenas os dados necessários para entrar no mundo.'],
+  preparing_runtime: ['Preparando o Webaverse…', 'Inicializando o mundo depois da autenticação.'],
+  guild_required: ['Acesso ao Jarvis World', 'Você precisa fazer parte da comunidade autorizada para entrar.'],
+  disabled: ['Acesso ainda fechado', 'O Jarvis World ainda não está liberado para este piloto.'],
+  maintenance: ['Manutenção em andamento', 'O Jarvis World está temporariamente indisponível.'],
+  unsupported: ['WebGL indisponível', 'Ative a aceleração gráfica ou use um navegador compatível para entrar.'],
+  runtime_error: ['O mundo foi interrompido', 'O Webaverse não conseguiu continuar com segurança. Entre novamente.'],
+  error: ['Não foi possível entrar', 'Tente novamente em alguns instantes.'],
+};
+
+const hasWebGl = () => {
+  try {
+    const canvas = document.createElement('canvas');
+    const context = canvas.getContext('webgl2') || canvas.getContext('webgl');
+    context?.getExtension('WEBGL_lose_context')?.loseContext();
+    return Boolean(context);
+  } catch (err) {
+    return false;
+  }
+};
+
+const hasRequiredBrowserFeatures = () => (
+  typeof Worker !== 'undefined' &&
+  !navigator.userAgent.match(/(Firefox|MSIE)/) &&
+  hasWebGl()
+);
+
+const failureStage = error => {
+  if (error instanceof ActivityApiError && error.code === 'guild_membership_required') {
+    return {stage: 'guild_required'};
+  }
+  return {
+    stage: 'error',
+    message: error instanceof Error ? error.message : stageCopy.error[1],
+  };
+};
+
+export const ActivityRuntimeLoading = () => (
+  <main className={styles.shell} aria-live="polite">
+    <div className={styles.grid} aria-hidden="true" />
+    <section className={styles.card}>
+      <div className={styles.mark} aria-hidden="true">J</div>
+      <p className={styles.eyebrow}>DISCORD ACTIVITY</p>
+      <h1 className={styles.title}>{stageCopy.preparing_runtime[0]}</h1>
+      <p className={styles.message}>{stageCopy.preparing_runtime[1]}</p>
+    </section>
+  </main>
+);
+
+export const ActivityShell = ({children}) => {
+  const [state, setState] = useState({stage: 'checking'});
+  const attempt = useRef(0);
+
+  const start = useCallback(async () => {
+    const currentAttempt = ++attempt.current;
+    const update = next => {
+      if (attempt.current === currentAttempt) setState(next);
+    };
+    clearActivitySession();
+    try {
+      update({stage: 'checking'});
+      const health = await activityApi.health();
+      if (health.status === 'maintenance') {
+        update({stage: 'maintenance'});
+        return;
+      }
+      if (health.status !== 'ready') {
+        update({stage: 'disabled'});
+        return;
+      }
+      const clientId = import.meta.env.VITE_DISCORD_CLIENT_ID?.trim();
+      if (!clientId) throw new Error('Client ID da Activity não configurado.');
+
+      update({stage: 'waiting_discord'});
+      const code = await authorizeDiscord(clientId);
+      update({stage: 'exchanging'});
+      const exchange = await activityApi.exchange(code);
+      let accessToken = exchange.access_token;
+      try {
+        await authenticateDiscord(clientId, accessToken);
+      } finally {
+        accessToken = '';
+      }
+
+      update({stage: 'loading_profile'});
+      await Promise.all([activityApi.me(), activityApi.wallet()]);
+      if (!hasRequiredBrowserFeatures()) {
+        update({stage: 'unsupported'});
+        return;
+      }
+      update({stage: 'preparing_runtime'});
+      update({stage: 'ready'});
+    } catch (error) {
+      clearActivitySession();
+      update(failureStage(error));
+    }
+  }, []);
+
+  useEffect(() => {
+    start();
+    return () => {
+      attempt.current += 1;
+      clearActivitySession();
+    };
+  }, [start]);
+
+  useEffect(() => {
+    const handleRuntimeFailure = () => {
+      clearActivitySession();
+      setState({stage: 'runtime_error'});
+    };
+    const handleContextLost = event => {
+      event.preventDefault();
+      handleRuntimeFailure();
+    };
+    window.addEventListener('jarvis-webaverse-runtime-error', handleRuntimeFailure);
+    document.addEventListener('webglcontextlost', handleContextLost, true);
+    return () => {
+      window.removeEventListener('jarvis-webaverse-runtime-error', handleRuntimeFailure);
+      document.removeEventListener('webglcontextlost', handleContextLost, true);
+    };
+  }, []);
+
+  if (state.stage === 'ready') return children;
+
+  const copy = stageCopy[state.stage] || stageCopy.error;
+  return (
+    <main className={styles.shell}>
+      <div className={styles.grid} aria-hidden="true" />
+      <section className={styles.card} aria-live="polite">
+        <div className={styles.mark} aria-hidden="true">J</div>
+        <p className={styles.eyebrow}>DISCORD ACTIVITY</p>
+        <h1 className={styles.title}>{copy[0]}</h1>
+        <p className={styles.message}>{state.message || copy[1]}</p>
+        {(state.stage === 'error' || state.stage === 'runtime_error') && (
+          <button className={styles.button} type="button" onClick={start}>
+            Tentar novamente
+          </button>
+        )}
+      </section>
+      <p className={styles.security}>Identidade e permissões são validadas pelo backend do Jarvis</p>
+    </main>
+  );
+};
diff --git a/src/jarvis-compat/activity-api.mjs b/src/jarvis-compat/activity-api.mjs
new file mode 100644
index 0000000..d861635
--- /dev/null
+++ b/src/jarvis-compat/activity-api.mjs
@@ -0,0 +1,64 @@
+let activitySession = '';
+
+export class ActivityApiError extends Error {
+  constructor(code, status, message) {
+    super(message);
+    this.name = 'ActivityApiError';
+    this.code = code;
+    this.status = status;
+  }
+}
+
+const parse = async response => {
+  const payload = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw new ActivityApiError(
+      String(payload.error || 'request_failed'),
+      response.status,
+      String(payload.message || 'Não foi possível falar com o Jarvis.'),
+    );
+  }
+  return payload;
+};
+
+const authorized = async path => {
+  if (!activitySession) {
+    throw new ActivityApiError('missing_session', 401, 'A sessão não foi iniciada.');
+  }
+  return parse(await fetch(path, {
+    method: 'GET',
+    headers: {
+      Authorization: `Bearer ${activitySession}`,
+    },
+    cache: 'no-store',
+  }));
+};
+
+export const clearActivitySession = () => {
+  activitySession = '';
+};
+
+export const activityApi = {
+  async health() {
+    return parse(await fetch('/api/activity/health', {cache: 'no-store'}));
+  },
+  async exchange(code) {
+    const exchange = await parse(await fetch('/api/activity/auth/exchange', {
+      method: 'POST',
+      headers: {'Content-Type': 'application/json'},
+      cache: 'no-store',
+      body: JSON.stringify({code}),
+    }));
+    activitySession = String(exchange.activity_session || '');
+    if (!activitySession) {
+      throw new ActivityApiError('missing_session', 502, 'O Jarvis não criou uma sessão válida.');
+    }
+    return exchange;
+  },
+  me() {
+    return authorized('/api/activity/me');
+  },
+  wallet() {
+    return authorized('/api/activity/wallet');
+  },
+};
diff --git a/src/jarvis-compat/activity-discord.js b/src/jarvis-compat/activity-discord.js
new file mode 100644
index 0000000..cb3aa3b
--- /dev/null
+++ b/src/jarvis-compat/activity-discord.js
@@ -0,0 +1,34 @@
+import {DiscordSDK} from '@discord/embedded-app-sdk';
+
+let discordSdk;
+
+const getDiscordSdk = clientId => {
+  if (!discordSdk) discordSdk = new DiscordSDK(clientId);
+  return discordSdk;
+};
+
+export const authorizeDiscord = async clientId => {
+  const sdk = getDiscordSdk(clientId);
+  await sdk.ready();
+  const authorization = await sdk.commands.authorize({
+    client_id: clientId,
+    response_type: 'code',
+    state: '',
+    prompt: 'none',
+    scope: ['identify'],
+  });
+  if (!authorization.code) {
+    throw new Error('O Discord não retornou um código de autorização.');
+  }
+  return authorization.code;
+};
+
+export const authenticateDiscord = async (clientId, accessToken) => {
+  const sdk = getDiscordSdk(clientId);
+  await sdk.ready();
+  const authenticated = await sdk.commands.authenticate({access_token: accessToken});
+  if (!authenticated) {
+    throw new Error('O Discord não confirmou a autenticação da Activity.');
+  }
+};
+
