+// The upstream preauthenticator endpoint was retired. Keep its optional
+// settings-only interface inert so it cannot prevent the game runtime booting.
+const unavailable = async () => {
+  throw new Error('Legacy Webaverse preauthenticator is unavailable in Jarvis World.');
+};
+
+export default {
+  callAuthenticatedApi: unavailable,
+  setAuthenticatedApi: unavailable,
+  getAuthenticatedApi: async () => null,
+  hasAuthenticatedApi: async () => false,
+  deleteAuthenticatedApi: async () => false,
+};
